rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Products: public read, admin-only write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: anyone can create; only admin can read or update
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Config (shipping): public read, admin-only write
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin FCM tokens — written by authenticated admin device,
    // read by Cloud Functions (Admin SDK bypasses rules).
    match /fcm_tokens/{tokenId} {
      allow write: if request.auth != null;
      allow read:  if false; // only Cloud Function Admin SDK reads this
    }

    // Legacy admin collection (kept for any other admin docs)
    match /admin/{docId} {
      allow read, write: if request.auth != null;
      match /{subDoc} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
